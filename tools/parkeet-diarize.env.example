# parkeet-diarize.env.example
#
# Runtime configuration for the Parakeet Diarized service.
# Copy this file to /etc/parakeet-diarize/config.env, then edit it.
#
#   sudo cp tools/parkeet-diarize.env.example /etc/parakeet-diarize/config.env
#   sudo chmod 600 /etc/parakeet-diarize/config.env
#
# Lines starting with # are comments and have no effect.
# Uncomment a line to override the built-in default.

# ── Network ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Number of uvicorn worker processes.
# Each worker loads the full model into GPU memory (N workers = N × VRAM).
# Keep at 1 unless you need concurrent request handling and have enough VRAM.
WORKERS=1

# ── Model ────────────────────────────────────────────────────────────────────
# MODEL_ID=nvidia/parakeet-tdt-0.6b-v3

# ── Speaker diarization (pyannote.audio) ─────────────────────────────────────
# Required for diarization. Obtain a token at https://huggingface.co/settings/tokens
# and accept the pyannote/speaker-diarization-3.1 model agreement.
# HUGGINGFACE_ACCESS_TOKEN=hf_YOUR_TOKEN_HERE

# Enable/disable diarization globally.
# ENABLE_DIARIZATION=true

# Include speaker labels (e.g. "Speaker 1: ...") in the transcript text.
# INCLUDE_DIARIZATION_IN_TEXT=true

# ── Audio processing ─────────────────────────────────────────────────────────
# Maximum audio chunk length sent to the ASR model in one pass (seconds).
# Reduce if you hit OOM errors on long recordings.
# CHUNK_DURATION=500

# Temporary directory for intermediate audio files.
# With PrivateTmp=true in the service unit this path lives in a private
# namespace and is invisible to other services.
# TEMP_DIR=/tmp/parakeet

# ── GPU / inference stability (advanced) ─────────────────────────────────────
# Enable NeMo's RNNT/TDT greedy CUDA graph decoder.
# Leave off unless you have tested it on your GPU stack — unstable on
# PyTorch 2.11 + CUDA 13 + Blackwell sm_120 (illegal memory access crashes).
# USE_CUDA_GRAPH_DECODER=false

# torch.backends.cudnn.benchmark — can speed up fixed-size inputs but adds
# overhead when input sizes vary (typical for audio of different lengths).
# CUDNN_BENCHMARK=false

# Force FP32 inside model.transcribe() by disabling autocast.
# Use if you encounter numerical issues with mixed-precision inference.
# FORCE_FP32=false

# Use BF16 autocast inside model.transcribe().
# Recommended on RTX 4070/5070 (Ada/Blackwell): better numerical stability than
# FP16 at the same throughput. Mutually exclusive with FORCE_FP32.
# USE_BF16=false

# ── Encoder attention model ───────────────────────────────────────────────────
# When AUTO_ATTENTION=true the encoder automatically switches to local attention
# (rel_pos_local_attn, context [256,256] ≈ ±20 s) for audio longer than
# LOCAL_ATTENTION_THRESHOLD seconds.  This reduces attention complexity from
# O(n²) to O(n) for long recordings with negligible accuracy loss.
# When AUTO_ATTENTION=false (default) global attention is always used.
# AUTO_ATTENTION=false
# LOCAL_ATTENTION_THRESHOLD=60

# ── CPU thread limits ─────────────────────────────────────────────────────────
# Restrict how many CPU threads PyTorch/OpenMP/MKL may use.
# Useful when the server shares cores with other services.
# OMP_NUM_THREADS=
# MKL_NUM_THREADS=
# NUMEXPR_MAX_THREADS=
